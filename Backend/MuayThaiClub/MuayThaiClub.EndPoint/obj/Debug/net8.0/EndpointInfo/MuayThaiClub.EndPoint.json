{
  "openapi": "3.0.1",
  "info": {
    "title": "MuayThaiClub.EndPoint",
    "version": "1.0"
  },
  "paths": {
    "/User/Register": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserRegisterResultDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRegisterResultDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRegisterResultDto"
                }
              }
            }
          }
        }
      }
    },
    "/User/Login": {
      "post": {
        "tags": [
          "User"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/UserLoginResultDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserLoginResultDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserLoginResultDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserLoginDto": {
        "required": [
          "emailAddress",
          "password"
        ],
        "type": "object",
        "properties": {
          "emailAddress": {
            "maxLength": 255,
            "type": "string",
            "nullable": true
          },
          "password": {
            "maxLength": 255,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserLoginResultDto": {
        "type": "object",
        "properties": {
          "isSuccessful": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UserRegisterDto": {
        "required": [
          "emailAddress",
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "emailAddress": {
            "maxLength": 255,
            "type": "string",
            "nullable": true
          },
          "userName": {
            "maxLength": 255,
            "type": "string",
            "nullable": true
          },
          "password": {
            "maxLength": 255,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserRegisterResultDto": {
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}